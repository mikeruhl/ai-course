# LLM Provider — "azure" (default) or "vertex"
# For Vertex AI: fill in the GCP values and run `gcloud auth application-default login`
LLM_PROVIDER=azure

# Azure AD / Entra ID
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=<app-registration-secret>

# Agent service URLs (from terraform outputs)
PLANNER_AGENT_URL=https://<planner-agent>.<region>.azurecontainerapps.io
RESEARCHER_AGENT_URL=https://<researcher-agent>.<region>.azurecontainerapps.io

# Managed Identity (used in Container Apps — set automatically)
# AZURE_CLIENT_ID=<managed-identity-client-id>  # override for user-assigned MI

# Google Vertex AI settings (used when LLM_PROVIDER=vertex)
# Requires: gcloud auth application-default login
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=us-central1
# VERTEX_MODEL=google/gemini-2.0-flash
