// ============================================================
// BONUS QUERY: Cost by feature name (if you set agent.feature_name)
// ============================================================
// This query shows which features are driving LLM costs.
// Requires that your spans have the custom attribute: agent.feature_name
//
dependencies
| where timestamp > ago(7d)
| where name == "llm_call"
| extend
    feature = tostring(customDimensions["agent.feature_name"]),
    input_tokens = toint(customDimensions["gen_ai.usage.input_tokens"]),
    output_tokens = toint(customDimensions["gen_ai.usage.output_tokens"]),
    model = tostring(customDimensions["gen_ai.request.model"])
| summarize
    total_input = sum(input_tokens),
    total_output = sum(output_tokens),
    call_count = count()
  by feature, model
| extend
    // Approximate cost — update prices for your model/region
    cost_usd = (total_input * 0.0000025) + (total_output * 0.00001)
| order by cost_usd desc
