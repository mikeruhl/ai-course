# LLM Provider — "azure" (default) or "vertex"
# For Vertex AI: fill in the GCP values and run `gcloud auth application-default login`
LLM_PROVIDER=azure

# Copy to .env and fill in values
# Never commit .env to version control

# Azure OpenAI — reuse from module-01 terraform output
AZURE_OPENAI_ENDPOINT=https://<your-account-name>.openai.azure.com
AZURE_OPENAI_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure AI Search — from module-09 terraform output (needed for Task 4)
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
AZURE_SEARCH_KEY=<your-admin-key>
AZURE_SEARCH_INDEX=<your-index-name>

# Knowledge base path — directory of markdown files for Task 2
# Defaults to ./knowledge_base relative to the lab directory
KB_PATH=./knowledge_base

# Google Vertex AI settings (used when LLM_PROVIDER=vertex)
# Requires: gcloud auth application-default login
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=us-central1
# VERTEX_MODEL=google/gemini-2.0-flash
