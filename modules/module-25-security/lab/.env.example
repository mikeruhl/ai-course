# LLM Provider — "azure" (default) or "vertex"
# For Vertex AI: fill in the GCP values and run `gcloud auth application-default login`
LLM_PROVIDER=azure

# Azure OpenAI Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure AI Content Safety (optional — Task D)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-safety>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=<your-key>

# Google Vertex AI settings (used when LLM_PROVIDER=vertex)
# Requires: gcloud auth application-default login
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=us-central1
# VERTEX_MODEL=google/gemini-2.0-flash
