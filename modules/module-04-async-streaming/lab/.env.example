# LLM Provider — "ollama" (default, local), "azure", or "vertex"
# For Ollama: just install ollama and run `ollama pull llama3.1`
# For Azure: fill in the Azure OpenAI values below
# For Vertex AI: fill in the GCP values below
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Azure OpenAI settings (used when LLM_PROVIDER=azure)
# AZURE_OPENAI_ENDPOINT=https://<your-account>.openai.azure.com
# AZURE_OPENAI_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-02-01

# Google Vertex AI settings (used when LLM_PROVIDER=vertex)
# Requires: gcloud auth application-default login
# GCP_PROJECT_ID=<your-gcp-project-id>
# GCP_REGION=us-central1
# VERTEX_MODEL=google/gemini-2.0-flash
